generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String            @id @default(cuid())
  name       String            @default("Admin")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  accounts   PlatformAccount[]
  posts      Post[]
  keywords   Keyword[]
  autoRules  AutoRule[]
  ingestions IngestionRecord[]
  sourceWatches SourceWatch[]
  voiceSnippets      VoiceSnippet[]
  styleGuides        StyleGuide[]
  styleRules         StyleRule[]
  antiAiRules        AntiAiRule[]
  researchAssets     ResearchAsset[]
  competitorAccounts CompetitorAccount[]
  insightCards       InsightCard[]
  reusablePatterns   ReusablePattern[]
  topicCards         TopicCard[]
  operatingBriefs    OperatingBrief[]
  draftAssets        DraftAsset[]
  imageStylePresets  ImageStylePreset[]
  imageBriefs        ImageBrief[]
  imageAssets        ImageAsset[]
  performanceSignals PerformanceSignal[]
  learningRules      LearningRule[]
  titlePatterns      TitlePattern[]
  hookPatterns       HookPattern[]
  formatOutcomes     FormatOutcome[]
}

model PlatformAccount {
  id                String            @id @default(cuid())
  userId            String
  platform          String
  platformUserId    String
  platformUsername  String
  personaLabel      String?
  personaPrompt     String?
  defaultTone       String?
  topicFocus        String?
  hookStyle         String?
  ctaStyle          String?
  voiceGuardrails   String?
  autoGenerateEnabled Boolean         @default(false)
  autoGenerateTime  String?           @default("09:00")
  autoGenerateMode  String?           @default("scheduled")
  autoGeneratePrompt String?
  autoGenerateGoal  String?
  profilePictureUrl String?
  accessToken       String
  tokenType         String
  tokenExpiresAt    DateTime
  refreshToken      String?
  isActive          Boolean           @default(true)
  lastSyncedAt      DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts             Post[]
  metricsSnapshots  MetricsSnapshot[]
  keywordMatches    KeywordMatch[]
  automationLogs    AutomationLog[]
  voiceSnippets      VoiceSnippet[]
  styleGuides        StyleGuide[]
  styleRules         StyleRule[]
  antiAiRules        AntiAiRule[]
  researchAssets     ResearchAsset[]
  topicCards         TopicCard[]
  operatingBriefs    OperatingBrief[]
  draftAssets        DraftAsset[]
  performanceSignals PerformanceSignal[]
  learningRules      LearningRule[]

  @@unique([platform, platformUserId])
}

model Post {
  id              String         @id @default(cuid())
  userId          String
  accountId       String
  contentType     String
  title           String?
  textContent     String?
  htmlContent     String?
  excerpt         String?
  mediaUrls       String?
  featuredImageUrl String?
  categories      String?
  tags            String?
  topicTag        String?
  status          String
  scheduledAt     DateTime?
  publishedAt     DateTime?
  errorMessage    String?
  platformPostId  String?
  platformUrl     String?
  replyToPostId   String?
  sourceMatchId   String?
  isAutoGenerated Boolean        @default(false)
  requiresApproval Boolean       @default(false)
  approvalState   String?
  approvalToken   String?
  approvalRequestedAt DateTime?
  approvalDecisionAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  metrics         PostMetrics[]
  sourceMatch     KeywordMatch?   @relation("KeywordMatchGeneratedPosts", fields: [sourceMatchId], references: [id], onDelete: SetNull)
  draftAsset      DraftAsset?
  imageAssets     ImageAsset[]
  performanceSignals PerformanceSignal[]
}

model PostMetrics {
  id         String   @id @default(cuid())
  postId      String
  views       Int      @default(0)
  likes       Int      @default(0)
  replies     Int      @default(0)
  reposts     Int      @default(0)
  quotes      Int      @default(0)
  shares      Int      @default(0)
  capturedAt  DateTime @default(now())
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model MetricsSnapshot {
  id            String          @id @default(cuid())
  accountId      String
  followerCount  Int             @default(0)
  totalViews     Int             @default(0)
  totalLikes     Int             @default(0)
  totalReplies   Int             @default(0)
  totalReposts   Int             @default(0)
  totalQuotes    Int             @default(0)
  countryData    String?
  cityData       String?
  ageData        String?
  genderData     String?
  capturedAt     DateTime        @default(now())
  account        PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Keyword {
  id         String         @id @default(cuid())
  userId     String
  keyword    String
  isActive   Boolean        @default(true)
  matchMode  String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches    KeywordMatch[]
}

model KeywordMatch {
  id             String           @id @default(cuid())
  keywordId      String
  accountId      String?
  platformPostId String
  sourcePostId   String?
  authorUsername String
  authorId       String?
  postText       String
  postUrl        String?
  matchedAt      DateTime         @default(now())
  actionTaken    String?
  actionPostId   String?
  keyword        Keyword          @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  account        PlatformAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  generatedPosts Post[]           @relation("KeywordMatchGeneratedPosts")
  logs           AutomationLog[]

  @@unique([keywordId, platformPostId])
}

model AutoRule {
  id               String   @id @default(cuid())
  userId           String
  name             String
  isActive         Boolean  @default(true)
  triggerType      String
  triggerConfig    String
  actionType       String
  actionConfig     String
  dailyLimit       Int      @default(50)
  delayMinSeconds  Int      @default(30)
  delayMaxSeconds  Int      @default(300)
  executionCount   Int      @default(0)
  lastExecutedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs             AutomationLog[]
}

model AutomationLog {
  id            String       @id @default(cuid())
  ruleId        String?
  matchId       String?
  accountId     String?
  postId        String?
  actionType    String
  status        String
  detail        String?
  executedAt    DateTime     @default(now())
  rule          AutoRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  match         KeywordMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  account       PlatformAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

model AppSettings {
  id                    String   @id @default(cuid())
  automationPaused      Boolean  @default(false)
  keywordScanPaused     Boolean  @default(false)
  missionTitle          String?
  missionCurrentValue   Int?
  missionTargetValue    Int?
  missionUnit           String?  @default("月點擊")
  missionDeadline       DateTime?
  autopilotMode         String?  @default("near_full_auto")
  wordpressPublishMode  String?  @default("draft_only")
  globalPersonaPrompt   String?
  editorialDirection    String?
  editorialGoal         String?
  defaultTone           String?  @default("sharp-observer")
  aiProvider            String?  @default("auto")
  writingStyleProfile   String?
  affiliateLinkPolicy   String?
  affiliateBlockPrimary String?
  affiliateBlockSecondary String?
  affiliateDisclosure   String?
  affiliateCta          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model IngestionRecord {
  id            String   @id @default(cuid())
  userId        String
  sourceType    String
  sourceUrl     String?
  title         String?
  rawText       String?
  imageUrls     String?
  status        String   @default("processed")
  generatedPostIds String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SourceWatch {
  id            String   @id @default(cuid())
  userId        String
  label         String
  sourceType    String
  sourceUrl     String
  isActive      Boolean  @default(true)
  autoImportEnabled Boolean @default(false)
  preferredOutcome String? @default("threads")
  lastFetchedAt DateTime?
  lastItemTitle String?
  lastItemUrl   String?
  lastExcerpt   String?
  lastItemFingerprint String?
  lastHandledStatus String? @default("new")
  lastHandledAt DateTime?
  importCount   Int      @default(0)
  skipCount     Int      @default(0)
  threadsPickCount Int   @default(0)
  wordpressPickCount Int @default(0)
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VoiceSnippet {
  id         String           @id @default(cuid())
  userId     String
  accountId  String?
  source     String
  personaId  String?
  text       String
  topicTags  String[]
  toneTags   String[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    PlatformAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

model StyleGuide {
  id               String           @id @default(cuid())
  userId           String
  accountId        String?
  personaId        String?
  title            String
  summary          String
  coreSequence     String?
  preferredDevices String[]
  bannedPatterns   String[]
  evidenceSnippetIds String[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account          PlatformAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

model StyleRule {
  id         String           @id @default(cuid())
  userId     String
  accountId  String?
  personaId  String?
  type       String
  ruleText   String
  severity   String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    PlatformAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

model AntiAiRule {
  id          String           @id @default(cuid())
  userId      String
  accountId   String?
  label       String
  description String
  pattern     String
  severity    String
  examples    String[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     PlatformAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

model ResearchAsset {
  id             String           @id @default(cuid())
  userId         String
  accountId      String?
  sourceType     String
  title          String
  content        String
  sourceUrl      String?
  topicTags      String[]
  structureNotes String?
  evidenceLevel  String
  reusable       Boolean          @default(true)
  saturationLabel String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        PlatformAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  insightCards   InsightCard[]
}

model CompetitorAccount {
  id          String           @id @default(cuid())
  userId      String
  handle      String
  platform    String
  positioning String?
  summary     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts       CompetitorPost[]
}

model CompetitorPost {
  id                  String            @id @default(cuid())
  competitorAccountId String
  title               String
  hook                String?
  structure           String?
  summary             String?
  performanceLabel    String?
  angle               String?
  formatTags          String[]
  takeaways           String[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  competitorAccount   CompetitorAccount @relation(fields: [competitorAccountId], references: [id], onDelete: Cascade)
}

model InsightCard {
  id              String         @id @default(cuid())
  userId          String
  researchAssetId String?
  title           String
  insightText     String
  sourceLabel     String?
  angleLabel      String?
  reusable        Boolean        @default(true)
  evidenceLevel   String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  researchAsset   ResearchAsset? @relation(fields: [researchAssetId], references: [id], onDelete: SetNull)
}

model ReusablePattern {
  id          String   @id @default(cuid())
  userId      String
  label       String
  patternType String
  template    String
  summary     String?
  bestFor     String?
  lanes       String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TopicCard {
  id              String           @id @default(cuid())
  userId          String
  accountId       String?
  lane            String
  goal            String
  angle           String
  targetPlatform  String
  evidenceRefs    String[]
  score           Float            @default(0)
  status          String
  needsResearch   Boolean          @default(false)
  confidenceScore Float            @default(0)
  sourceType      String?
  missionTag      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         PlatformAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  briefs          OperatingBrief[]
  drafts          DraftAsset[]
}

model OperatingBrief {
  id             String           @id @default(cuid())
  userId         String
  accountId      String?
  topicCardId    String
  targetPlatform String
  targetOutcome  String
  audience       String
  hookStrategy   String
  ctaStrategy    String?
  whyNow         String?
  assignment     String?
  successMetric  String?
  retrievalNotes String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        PlatformAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  topicCard      TopicCard        @relation(fields: [topicCardId], references: [id], onDelete: Cascade)
  drafts         DraftAsset[]
}

model DraftAsset {
  id              String           @id @default(cuid())
  userId          String
  accountId       String?
  briefId         String
  topicCardId     String?
  postId          String?          @unique
  platform        String
  structure       String
  body            String
  confidenceScore Float            @default(0)
  antiAiFlags     String[]
  reviewLane      String           @default("direct")
  status          String           @default("draft")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         PlatformAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  brief           OperatingBrief   @relation(fields: [briefId], references: [id], onDelete: Cascade)
  topicCard       TopicCard?       @relation(fields: [topicCardId], references: [id], onDelete: SetNull)
  post            Post?            @relation(fields: [postId], references: [id], onDelete: SetNull)
  imageBriefs     ImageBrief[]
  imageAssets     ImageAsset[]
  performanceSignals PerformanceSignal[]
}

model ImageStylePreset {
  id              String   @id @default(cuid())
  userId          String
  name            String
  slug            String   @unique
  description     String
  visualDirection String
  promptPrefix    String
  aspectRatio     String
  defaultForLanes String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageBriefs     ImageBrief[]
}

model ImageBrief {
  id            String            @id @default(cuid())
  userId        String
  draftId       String
  imageRole     String
  stylePresetId String?
  prompt        String
  aspectRatio   String
  status        String            @default("pending")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft         DraftAsset        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  stylePreset   ImageStylePreset? @relation(fields: [stylePresetId], references: [id], onDelete: SetNull)
  assets        ImageAsset[]
}

model ImageAsset {
  id           String      @id @default(cuid())
  userId       String
  draftId      String?
  imageBriefId String?
  postId       String?
  url          String
  altText      String?
  status       String      @default("generated")
  provider     String?
  prompt       String?
  role         String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft        DraftAsset? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  imageBrief   ImageBrief? @relation(fields: [imageBriefId], references: [id], onDelete: SetNull)
  post         Post?       @relation(fields: [postId], references: [id], onDelete: SetNull)
}

model PerformanceSignal {
  id              String           @id @default(cuid())
  userId          String
  accountId       String?
  draftId         String?
  postId          String?
  contentId       String?
  platform        String
  impressions     Int              @default(0)
  bookmarks       Int              @default(0)
  follows         Int              @default(0)
  ctr             Float            @default(0)
  conversions     Int              @default(0)
  likes           Int              @default(0)
  replies         Int              @default(0)
  reposts         Int              @default(0)
  quotes          Int              @default(0)
  shares          Int              @default(0)
  titlePattern    String?
  hasNumber       Boolean          @default(false)
  hasIdentity     Boolean          @default(false)
  isTutorial      Boolean          @default(false)
  hasCaseStudy    Boolean          @default(false)
  usesPersonaStory Boolean         @default(false)
  capturedAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         PlatformAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  draft           DraftAsset?      @relation(fields: [draftId], references: [id], onDelete: SetNull)
  post            Post?            @relation(fields: [postId], references: [id], onDelete: SetNull)
}

model LearningRule {
  id              String           @id @default(cuid())
  userId          String
  accountId       String?
  scope           String
  signalType      String
  ruleText        String
  weight          Float            @default(0.5)
  isActive        Boolean          @default(true)
  lastValidatedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         PlatformAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

model TitlePattern {
  id              String   @id @default(cuid())
  userId          String
  label           String
  template        String
  hasNumber       Boolean  @default(false)
  hasIdentity     Boolean  @default(false)
  hasContrast     Boolean  @default(false)
  expectedOutcome String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HookPattern {
  id         String   @id @default(cuid())
  userId     String
  label      String
  template   String
  bestFor    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FormatOutcome {
  id          String   @id @default(cuid())
  userId      String
  label       String
  lane        String
  metricFocus String
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
